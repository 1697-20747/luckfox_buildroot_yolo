# Opt-in settings read by /usr/bin/yolo-app-start at boot.
#
# Hardware JPEG (Rockit VENC), default since 2026-10-12: on the yolo_camd base
# it passed 50/50 restarts and a 3 h continuous run (JPEG ~12 ms vs 29, CPU 75%
# vs 100%). The earlier freezes were the camera-restart eMMC hang. Software
# JPEG (libjpeg-turbo): remove these two lines. Safe mode also falls back to it.
LUCKFOX_PIPELINE=hwjpeg
LUCKFOX_HW_JPEG=1

# Model input size (2026-10-11): 800x448 matches the camera's 16:9 frame (the
# original 640x640 model gets the frame stretched). Made by
# tools/export_yolov8_rknn.sh 448 800. Remove to use the 640x640 model.
LUCKFOX_MODEL=yolov8n-448x800-rv1106-1.6.0.rknn
