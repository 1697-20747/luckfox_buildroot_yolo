# Opt-in settings read by /usr/bin/yolo-app-start at boot.
#
# LUCKFOX_HW_JPEG only matters for a build made with -DLUCKFOX_HW_JPEG (Rockit
# VENC hardware JPEG), which tools/build_app.sh no longer makes: it froze the
# board intermittently (2026-10-11). The default build uses libjpeg-turbo.
LUCKFOX_HW_JPEG=0
