# Opt-in settings read by /usr/bin/yolo-app-start at boot.
#
# Hardware JPEG via Rockit VENC: 8.9fps vs 5.4fps, but OFF for now.
# Real result 2026-10-11: stopping the server in hardware mode (deploy,
# restart) froze the whole board -- 2 bad stops in ~9 even with the
# graceful VENC shutdown -- so every restart risked a power cycle.
# Set to 1 only while investigating.
LUCKFOX_HW_JPEG=0
