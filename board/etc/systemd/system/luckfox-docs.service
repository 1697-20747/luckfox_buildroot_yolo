[Unit]
Description=Luckfox Pico Ultra docs site (Hugo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pico/docs-site
ExecStart=/usr/local/bin/hugo server --bind 0.0.0.0 --port 1313 --baseURL http://192.168.1.180:1313/ --disableLiveReload --disableFastRender --noHTTPCache --watch=false
Restart=on-failure
RestartSec=5
User=pico

[Install]
WantedBy=multi-user.target
