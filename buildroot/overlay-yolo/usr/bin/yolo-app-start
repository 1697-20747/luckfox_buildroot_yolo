#!/bin/sh
# luckfox_buildroot_yolo: started by S21appinit in place of rkipc, once the
# camera/NPU kernel modules are loaded. Runs Rockchip's 3A server (auto
# exposure / white balance via the sensor's IQ tuning file) and, if
# installed, the YOLO HUD stream server. Logs: /var/log/yolo-*.log
#
# Boot-loop guard: a marker on /userdata is set before the app starts and
# cleared once it has run 60s. If a boot finds the marker still there, the
# previous boot hung (2026-10-10: an experimental hardware-JPEG build froze
# the board at startup, which with auto-start would repeat every boot), so
# this boot runs the app with experimental options forced off.
APP_DIR=/root/rknn_test
GUARD=/userdata/.yolo-app-starting
case "$1" in
	stop)
		# a deliberate stop is not a hang: clear the boot-loop guard too
		# (killing this script also kills its 60s clear-the-guard timer)
		rm -f $GUARD; sync
		killall luckfox_video_hud_stream_cam rkaiq_3A_server 2>/dev/null
		exit 0
		;;
esac
export PATH=/oem/usr/bin:$PATH LD_LIBRARY_PATH=/oem/usr/lib:$LD_LIBRARY_PATH
mkdir -p /var/log
rkaiq_3A_server > /var/log/yolo-3a.log 2>&1 &
sleep 2

# opt-in settings for the app, e.g. LUCKFOX_HW_JPEG=1
# set -a: everything app.env assigns is exported to the app (e.g.
# LUCKFOX_CAM_HFOV_DEG / LUCKFOX_CAM_VFOV_DEG for navigation bearings)
set -a; [ -f $APP_DIR/app.env ] && . $APP_DIR/app.env; set +a
if [ -f $GUARD ]; then
	echo "$(date) previous boot did not clear $GUARD: safe mode (experimental options off)" >> /var/log/yolo-stream.log
	unset LUCKFOX_HW_JPEG LUCKFOX_VENC_FMT
fi
export LUCKFOX_HW_JPEG LUCKFOX_VENC_FMT

if [ -x $APP_DIR/luckfox_video_hud_stream_cam ]; then
	touch $GUARD; sync
	( sleep 60; rm -f $GUARD; sync ) &
	cd $APP_DIR
	# restart if it ever exits (like systemd's Restart=on-failure on Ubuntu)
	while true; do
		./luckfox_video_hud_stream_cam yolov8n-optimized-rv1106-1.6.0.rknn /dev/video11 \
			coco_80_labels_list.txt 8080 >> /var/log/yolo-stream.log 2>&1
		echo "stream exited $?, restarting in 5s" >> /var/log/yolo-stream.log
		sleep 5
	done
fi
