#!/bin/sh
# luckfox_buildroot_yolo: boot-time kernel settings for the stream server.
#
# The hardware watchdog (/dev/watchdog, enabled by kernel-patches/0002) is owned
# by yolo_supervisor, a static, memory-locked program that feeds it only while
# the stream server's heartbeat is fresh and storage answers.
case "$1" in
	start)
		# Hung-task detection off: Rockchip's rockit kernel threads (vlog,
		# valloc, vsys, ...) idle in uninterruptible sleep by design, so with
		# hung_task_panic every boot panicked ~60s in (seen 2026-10-11).
		echo 0 > /proc/sys/kernel/hung_task_panic 2>/dev/null
		echo 0 > /proc/sys/kernel/hung_task_timeout_secs 2>/dev/null
		# debugfs: yolo_supervisor reads the eMMC controller state from it on a
		# storage fault (2026-10-11 eMMC investigation)
		mount -t debugfs none /sys/kernel/debug 2>/dev/null
		# persistent health log (/userdata/healthlog.txt), see yolo-healthlog
		/usr/bin/yolo-healthlog > /dev/null 2>&1 &
		# hardware-watchdog supervisor: resets the board (after dumping every
		# task's state to the RAM crash log) if the stream server or storage
		# hangs -- see scripts/yolo_supervisor.c
		[ -x /root/rknn_test/yolo_supervisor ] && /root/rknn_test/yolo_supervisor > /dev/null 2>&1 &
		;;
	stop)
		;;
	*)
		exit 1
		;;
esac
