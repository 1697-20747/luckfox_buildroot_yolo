#!/bin/sh
# luckfox_buildroot_yolo: boot-time kernel settings for the stream server.
#
# The hardware watchdog (/dev/watchdog, enabled by kernel-patches/0002) is fed
# by the stream server itself, not by a separate daemon: a separate feeder
# kept feeding through a real half-alive freeze (2026-10-11), and a monitor
# reading /proc hung in it. See watchdog_arm() in the stream server.
case "$1" in
	start)
		# Hung-task detection off: Rockchip's rockit kernel threads (vlog,
		# valloc, vsys, ...) idle in uninterruptible sleep by design, so with
		# hung_task_panic every boot panicked ~60s in (seen 2026-10-11).
		echo 0 > /proc/sys/kernel/hung_task_panic 2>/dev/null
		echo 0 > /proc/sys/kernel/hung_task_timeout_secs 2>/dev/null
		# persistent health log (/userdata/healthlog.txt), see yolo-healthlog
		/usr/bin/yolo-healthlog > /dev/null 2>&1 &
		;;
	stop)
		;;
	*)
		exit 1
		;;
esac
