--- a/arch/arm/boot/dts/rv1106-luckfox-pico-ultra-ipc.dtsi
+++ b/arch/arm/boot/dts/rv1106-luckfox-pico-ultra-ipc.dtsi
@@ -473,7 +473,17 @@ &i2c1 {
 	pinctrl-0 = <&i2c1m1_xfer>;
 };
 &i2c2 {
+	/* luckfox_buildroot_yolo: GY-521 / MPU-6050 on header pins 32 (SCL)
+	 * and 33 (SDA). Only VDD/GND/SCL/SDA wired, no INT line, so no
+	 * interrupts property: the driver runs in polled/direct mode. */
+	status = "okay";
+	clock-frequency = <100000>;
 	pinctrl-0 = <&i2c2m0_xfer>;
+
+	mpu6050@68 {
+		compatible = "invensense,mpu6050";
+		reg = <0x68>;
+	};
 };
 &i2c3 {
 	pinctrl-names = "default", "config";
